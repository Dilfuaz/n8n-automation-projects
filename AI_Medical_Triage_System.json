        "jsCode": "// Deteksi apakah data berasal dari Telegram atau WAHA\nconst isTelegram = $input.item.json.message !== undefined;\n\nlet standardizedData = {};\n\nif (isTelegram) {\n  // === FORMAT TELEGRAM ===\n  standardizedData = {\n    platform: 'telegram',\n    chat_id: String($input.item.json.message.chat.id),\n    user_name: $input.item.json.message.from?.first_name || 'Pasien',\n    message_text: $input.item.json.message.text || '',\n    raw_data: $input.item.json \n  };\n} else {\n  // === FORMAT WAHA (WHATSAPP) ===\n  const wahaData = $input.item.json;\n  \n  standardizedData = {\n    platform: 'whatsapp',\n    // Hapus suffix '@c.us' kalau ada, ambil angka murni\n    chat_id: String(wahaData.chatId || wahaData.sender || '').replace('@c.us', ''),\n    user_name: wahaData.senderName || wahaData.pushName || 'Pasien',\n    message_text: wahaData.body || wahaData.text || wahaData.message || '',\n    raw_data: wahaData\n  };\n}\n\nreturn { json: standardizedData };"
