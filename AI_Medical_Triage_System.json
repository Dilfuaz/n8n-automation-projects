      "parameters": {
        "jsCode": "// Ambil output text dari AI\nconst aiOutput = $input.first().json.text;\n\n// Parse string JSON menjadi object JavaScript\ntry {\n  const parsedData = JSON.parse(aiOutput);\n  \n  // Kembalikan data yang sudah rapi\n  return {\n    json: parsedData\n  };\n} catch (error) {\n  // Kalau AI ngawur dan bukan JSON, kembalikan error\n  return {\n    json: {\n      error: \"Gagal parse JSON dari AI\",\n      raw: aiOutput\n    }\n  };\n}"
      },
